{
  "name": "pdfjs-serverless",
  "type": "module",
  "version": "1.4.0",
  "packageManager": "pnpm@12.14.0",
  "description": "PDF.js redistributed as a bundle for edge and serverless runtimes",
  "author": "Johann Schopplich <hello@johannschopplich.com>",
  "license": "MIT",
  "homepage": "https://github.com/johannschopplich/pdfjs-serverless#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johannschopplich/pdfjs-serverless.git"
  },
  "bugs": {
    "url": "https://github.com/johannschopplich/pdfjs-serverless/issues"
  },
  "keywords": [
    "cloudflare",
    "edge",
    "nodeless",
    "parse",
    "pdf",
    "pdf.js",
    "pdfjs-dist",
    "serverless",
    "text-extraction",
    "workers"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rolldown --config rolldown.config.ts",
    "test": "vitest",
    "test:types:dist": "tsc -p test/types/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "release": "bumpp"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@cloudflare/vitest-plugin": "^1.4.3",
    "@types/node": "^26.6.5",
    "bumpp": "^12.3.0",
    "eslint": "^10.12.0",
    "pdfjs-dist": "~6.4.299",
    "rolldown": "^1.2.14",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  }
}
